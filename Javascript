// Initialize settings with some default values
let settings = {
  theme: "light",
  notifications: "enabled",
  volume: "medium"
};

// Function to add a setting
function addSetting(settings, key, value) {
  key = key.toLowerCase();
  value = value.toLowerCase();

  if (key in settings) {
    return `Setting '${key}' already exists! Cannot add a new setting with this name.`;
  } else {
    settings[key] = value;
    return `Setting '${key}' added with value '${value}' successfully!`;
  }
}

// Function to update a setting
function updateSetting(settings, key, value) {
  key = key.toLowerCase();
  value = value.toLowerCase();

  if (key in settings) {
    settings[key] = value;
    return `Setting '${key}' updated to '${value}' successfully!`;
  } else {
    return `Setting '${key}' does not exist! Cannot update a non-existing setting.`;
  }
}

// Function to delete a setting
function deleteSetting(settings, key) {
  key = key.toLowerCase();

  if (key in settings) {
    delete settings[key];
    return `Setting '${key}' deleted successfully!`;
  } else {
    return "Setting not found!";
  }
}

// Function to view all settings
function viewSettings(settings) {
  if (Object.keys(settings).length === 0) {
    return "No settings available.";
  }

  let result = "Current User Settings:\n";
  for (let key in settings) {
    // Capitalize the first letter of the key
    const capitalizedKey = key.charAt(0).toUpperCase() + key.slice(1);
    result += `${capitalizedKey}: ${settings[key]}\n`;
  }

  return result;
}

// Function to update the settings display
function updateSettingsDisplay() {
  const outputElement = document.getElementById("settings-output");
  outputElement.textContent = viewSettings(settings);
}

// Initialize the display
updateSettingsDisplay();

// Add event listener for the add form
document.getElementById("add-form").addEventListener("submit", function (e) {
  e.preventDefault();

  const keyInput = document.getElementById("add-key");
  const valueInput = document.getElementById("add-value");
  const messageElement = document.getElementById("add-message");

  const key = keyInput.value;
  const value = valueInput.value;

  const result = addSetting(settings, key, value);

  // Display the result message
  messageElement.textContent = result;
  messageElement.className =
    "message " + (result.includes("successfully") ? "success" : "error");

  // Update the settings display
  updateSettingsDisplay();

  // Clear the form
  keyInput.value = "";
  valueInput.value = "";

  // Clear the message after 3 seconds
  setTimeout(() => {
    messageElement.textContent = "";
    messageElement.className = "message";
  }, 3000);
});

